# Choose ONE provider and fill in its key. LLM_PROVIDER controls which one is used.
LLM_PROVIDER=grok
# gemini, openai, or grok

GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Grok (xAI) - get a key at https://console.x.ai
# Note: embeddings run on a free local model automatically when using grok,
# so no separate embeddings key is needed.
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-latest
